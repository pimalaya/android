<?xml version="1.0" encoding="utf-8"?>
<!-- A type of its own: contacts apps list every account of a type with a
     contacts adapter, syncable or not, and would show the calendar accounts
     as empty books. Made syncable as they are created
     (Accounts.reconcileCalendars). -->
<sync-adapter xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="org.pimalaya.calendar"
    android:allowParallelSyncs="false"
    android:contentAuthority="com.android.calendar"
    android:isAlwaysSyncable="false"
    android:supportsUploading="true"
    android:userVisible="true" />
