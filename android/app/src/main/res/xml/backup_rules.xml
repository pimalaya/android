<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11: backup is off (allowBackup), and should a device
     transfer tool still ask, every domain is excluded, as on later
     versions (data_extraction_rules). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
