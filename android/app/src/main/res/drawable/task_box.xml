<?xml version="1.0" encoding="utf-8"?>
<!-- A task's box, at the avatar's size and inset. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <inset android:inset="@dimen/item_avatar_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/task_box_radius" />
                <stroke
                    android:width="@dimen/task_box_stroke"
                    android:color="@color/ink_secondary" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:inset="@dimen/item_avatar_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/task_box_radius" />
                <solid android:color="#FFFFFF" />
            </shape>
        </inset>
    </item>
</ripple>
