<?xml version="1.0" encoding="utf-8"?>
<!-- A bar's toolbox (ToolGroup): the reader's tonal pill, inset by the
     4dp a round bar button keeps around it, so an empty group, measured
     to nothing, leaves no gap. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="4dp">
    <shape>
        <solid android:color="@color/surface" />
        <corners android:radius="1000dp" />
    </shape>
</inset>
