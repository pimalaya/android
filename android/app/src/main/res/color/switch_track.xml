<?xml version="1.0" encoding="utf-8"?>
<!-- A switch's track in the palette: the accent when on, the divider tone
     when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="?android:attr/disabledAlpha" android:color="@color/divider" android:state_enabled="false" />
    <item android:color="@color/accent" android:state_checked="true" />
    <item android:color="@color/divider" />
</selector>
