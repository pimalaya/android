<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The app's own palette over the platform's widgets
         (cairn/changes/brand-palette): DeviceDefault for the widgets'
         shapes, its colours replaced, so the app looks itself on every
         phone. The night variant in values-night/ switches to the dark
         base and palette, following the system light/dark setting. The
         main bars and the status bar sit on the page tone, the cards,
         pills and bottom navigation on the surface colour, never on
         colorPrimary. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="android:textColorTertiary">@color/brand_text_secondary</item>
        <item name="android:textColorHint">@color/brand_text_hint</item>
        <item name="android:colorControlNormal">@color/ink_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorError">@color/error</item>
        <!-- The platform's widgets in the palette rather than the
             wallpaper's colours DeviceDefault takes from Android 12 on:
             popups and menus, ripples, links, selections, boxes and
             spinners; a switch is tinted in code (Switches). -->
        <item name="android:colorBackgroundFloating">@color/dialog_ground</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorLink">@color/accent</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="android:checkboxStyle">@style/AppCheckBox</item>
        <item name="android:radioButtonStyle">@style/AppRadioButton</item>
        <item name="android:progressBarStyle">@style/AppProgress</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:datePickerDialogTheme">@style/AppDialog</item>
        <item name="android:timePickerDialogTheme">@style/AppDialog</item>

        <!-- Matches the app bars on API 26-34; API 35+ ignores
             both, edge-to-edge padding the bars instead. -->
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <!-- Dialogs and the date and time pickers in the same palette, not
         the maker's. -->
    <style name="AppDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/dialog_ground</item>
        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="android:textColorHint">@color/brand_text_hint</item>
        <item name="android:colorControlNormal">@color/ink_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorError">@color/error</item>
        <!-- The platform's widgets in the palette rather than the
             wallpaper's colours DeviceDefault takes from Android 12 on:
             popups and menus, ripples, links, selections, boxes and
             spinners; a switch is tinted in code (Switches). -->
        <item name="android:colorBackgroundFloating">@color/dialog_ground</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorLink">@color/accent</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="android:checkboxStyle">@style/AppCheckBox</item>
        <item name="android:radioButtonStyle">@style/AppRadioButton</item>
        <item name="android:progressBarStyle">@style/AppProgress</item>
    </style>

    <!-- The sync sheet: a floating window on the bottom edge over a scrim,
         sliding up as the keyboard does, in the app's palette (SyncDock). -->
    <style name="SyncSheet" parent="AppTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>

</resources>
