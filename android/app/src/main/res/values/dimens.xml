<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The design's bar: 60dp under the status bar, its 40dp buttons
         (4dp margin each) 12dp in from the screen's edges. -->
    <dimen name="app_bar_height">60dp</dimen>
    <dimen name="app_bar_padding">8dp</dimen>
    <dimen name="app_bar_button">48dp</dimen>
    <dimen name="app_bar_icon">24dp</dimen>
    <dimen name="app_bar_title_padding">4dp</dimen>

    <!-- A bar's toolbox (ToolGroup), the reader's: a 40dp tonal pill of
         38 by 36dp icon buttons, its 48dp height and 6dp padding holding
         the pill's 4dp inset. -->
    <dimen name="app_bar_tools_height">48dp</dimen>
    <dimen name="app_bar_tools_padding">6dp</dimen>
    <dimen name="app_bar_tool_width">38dp</dimen>
    <dimen name="app_bar_tool_height">36dp</dimen>

    <!-- A bar toggle (the calendar's modes): the toolbox's shape, the
         one on on the nav indicator, 40dp tall in all. -->
    <dimen name="app_bar_toggle_width">38dp</dimen>
    <dimen name="app_bar_toggle_height">36dp</dimen>
    <dimen name="app_bar_toggle_padding">2dp</dimen>
    <dimen name="app_bar_toggle_margin">4dp</dimen>

    <!-- Every spinner's size: the platform's draws its stroke in
         proportion to its size, so one size keeps one thickness. The
         icon grid's. -->
    <dimen name="spinner">24dp</dimen>

    <dimen name="fab">56dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="fab_elevation">6dp</dimen>

    <!-- Shared list-item metrics: a tappable row's height, side padding
         and leading icon size, for the filter sheet and the nav glyphs. -->
    <dimen name="item_height">48dp</dimen>
    <dimen name="item_padding">16dp</dimen>
    <dimen name="item_icon">24dp</dimen>

    <!-- A row's trailing glyph (replied, an entry's kind): sized off
         the line it ends rather than the 24dp icon grid. -->
    <dimen name="message_flag">16dp</dimen>

    <!-- How far a disc sits inside its view, drawn rather than laid out
         (Avatar insets it), so a disc can be smaller than its column
         without leaving the column's axis. This is the one number to
         change to resize every avatar. -->
    <dimen name="item_avatar_inset">2dp</dimen>

    <!-- The grouped lists: rows sit in rounded cards inset from the
         screen edge, under a section header, below a large title. -->
    <dimen name="card_radius">22dp</dimen>
    <dimen name="card_gutter">12dp</dimen>
    <dimen name="card_avatar">42dp</dimen>
    <dimen name="task_box_radius">12dp</dimen>
    <dimen name="task_box_stroke">2dp</dimen>
    <dimen name="large_title">32sp</dimen>

    <!-- The week card's day discs and calendar dots. -->
    <dimen name="week_day">38dp</dimen>
    <dimen name="week_day_ring_gap">4dp</dimen>
    <dimen name="week_dot">12dp</dimen>
    <dimen name="week_dot_ring">2dp</dimen>
    <dimen name="week_dot_overlap">6dp</dimen>
    <dimen name="week_dots_gap">4dp</dimen>

    <!-- A domain's tile on the setup's servers page: its glyph on a
         rounded square, filled with the accent while the domain is
         picked, a check badge overhanging its corner. -->
    <dimen name="domain_tile">36dp</dimen>
    <dimen name="domain_tile_radius">12dp</dimen>
    <dimen name="domain_tile_glyph">20dp</dimen>
    <dimen name="domain_tile_ring">1.5dp</dimen>
    <dimen name="domain_tile_badge">20dp</dimen>
    <dimen name="domain_tile_badge_glyph">16dp</dimen>
    <dimen name="domain_tile_overhang">6dp</dimen>

    <!-- The bottom navigation: an icon on its indicator pill over a
         label, per item. -->
    <dimen name="nav_height">80dp</dimen>
    <dimen name="nav_indicator_width">64dp</dimen>
    <dimen name="nav_indicator_height">32dp</dimen>

    <!-- The extended FAB's distance from the bottom: the navigation's
         height plus the usual FAB margin. -->
    <dimen name="fab_above_nav">96dp</dimen>

    <!-- The sync dock's height, which the extended FAB rises by while it
         shows. -->
    <dimen name="sync_dock_height">64dp</dimen>
</resources>
