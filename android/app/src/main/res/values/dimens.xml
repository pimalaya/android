<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="app_bar_height">64dp</dimen>
    <dimen name="app_bar_padding">4dp</dimen>
    <dimen name="app_bar_button">48dp</dimen>
    <dimen name="app_bar_icon">24dp</dimen>
    <dimen name="app_bar_title_padding">4dp</dimen>

    <dimen name="fab">56dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="fab_elevation">6dp</dimen>

    <!-- Shared list-item metrics: one source of truth for a tappable row's
         height, side padding, leading icon size, icon-to-text gap and text
         size. Reusable everywhere; wired to the drawer rows for now. -->
    <dimen name="item_height">48dp</dimen>
    <dimen name="item_padding">16dp</dimen>
    <dimen name="item_icon">24dp</dimen>
    <dimen name="item_gap">16dp</dimen>
    <dimen name="item_text">16sp</dimen>

    <!-- A mail row's flag glyph: sized off the line it sits on (13sp)
         rather than the 24dp icon grid, so three of them fit under a
         date without widening the trailing column. -->
    <dimen name="message_flag">16dp</dimen>

    <!-- A list row's leading disc: inside the 48dp column it starts in
         rather than filling it. Matching a bar button exactly made the
         disc read as another button, and the two are a scroll apart
         rather than side by side, so the likeness bought less than the
         extra weight cost. -->
    <dimen name="item_avatar">44dp</dimen>

    <!-- Where a list row's avatar starts: under the bar's first domain
         button, which is the bar padding plus the burger plus the gap
         before it (4 + 48 + 4), so the rows hang off the navigation.
         Flush with the burger instead read as clamped against the
         screen edge.

         The mail and agenda rows reach it by padding 4dp and leading
         with an item_lead column; the contacts row pads the whole 56dp,
         since what fills its column is an overlay above the list rather
         than anything the row itself draws. -->
    <dimen name="item_start">56dp</dimen>

    <!-- The leading column every list row keeps clear, inside
         item_start: the contacts list puts its sticky section letter
         there, the agenda a countdown, the mail list a paperclip. -->
    <dimen name="item_lead">@dimen/app_bar_button</dimen>
</resources>
