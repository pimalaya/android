<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="app_bar_height">64dp</dimen>
    <dimen name="app_bar_padding">4dp</dimen>
    <dimen name="app_bar_button">48dp</dimen>
    <dimen name="app_bar_icon">24dp</dimen>
    <dimen name="app_bar_title_padding">4dp</dimen>

    <dimen name="fab">56dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="fab_elevation">6dp</dimen>

    <!-- Shared list-item metrics: a tappable row's height, side padding
         and leading icon size, for the filter sheet and the nav glyphs. -->
    <dimen name="item_height">48dp</dimen>
    <dimen name="item_padding">16dp</dimen>
    <dimen name="item_icon">24dp</dimen>

    <!-- A row's trailing glyph (replied, an entry's kind): sized off
         the line it ends rather than the 24dp icon grid. -->
    <dimen name="message_flag">16dp</dimen>

    <!-- How far a disc sits inside its view, drawn rather than laid out
         (Avatar insets it), so a disc can be smaller than its column
         without leaving the column's axis. This is the one number to
         change to resize every avatar. -->
    <dimen name="item_avatar_inset">2dp</dimen>

    <!-- The grouped lists: rows sit in rounded cards inset from the
         screen edge, under a section header, below a large title. -->
    <dimen name="card_radius">22dp</dimen>
    <dimen name="card_gutter">12dp</dimen>
    <dimen name="card_avatar">42dp</dimen>
    <dimen name="large_title">32sp</dimen>

    <!-- The bottom navigation: an icon on its indicator pill over a
         label, per item. -->
    <dimen name="nav_height">80dp</dimen>
    <dimen name="nav_indicator_width">64dp</dimen>
    <dimen name="nav_indicator_height">32dp</dimen>

    <!-- The extended FAB's distance from the bottom: the navigation's
         height plus the usual FAB margin. -->
    <dimen name="fab_above_nav">96dp</dimen>
</resources>
