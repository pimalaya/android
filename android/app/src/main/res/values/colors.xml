<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Neutral surfaces; the night variant lives in values-night/. Every
         other colour is pulled from the device theme (?android:attr/...). -->
    <color name="divider">#BDBDBD</color>
    <color name="divider_light">#E0E0E0</color>
    <color name="surface">#EEEEEE</color>

    <!-- A starred message's star: the one fixed hue, since a yellow
         star is what marks importance whatever the theme's accent. -->
    <color name="star">#F2BE3C</color>
    <color name="widget_ground">#FFFFFF</color>
    <color name="widget_text">#1C1B1F</color>
    <color name="widget_text_secondary">#5E5E62</color>

</resources>
