<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The app's palette, the logo's magenta over warm greys leaning to
         it (cairn/changes/brand-palette); the night variant lives in
         values-night/. The theme hands them to the platform's attributes
         (colorAccent, colorBackground, textColor*), which the views read. -->
    <color name="accent">#BF1E83</color>
    <!-- Accent text on a tonal fill. -->
    <color name="accent_ink">#97156A</color>
    <color name="page">#FFFFFF</color>
    <color name="ink">#301F2A</color>
    <color name="ink_secondary">#6F5464</color>
    <!-- A tonal fill, the accent washed out. -->
    <color name="wash">#F7D9EA</color>
    <!-- A dialog's ground: the page in light, a step above it in dark. -->
    <color name="dialog_ground">#FFFFFF</color>
    <color name="error">#BA1A1A</color>
    <!-- Text on an accent light enough to need it (WCAG luminance above
         0.179), the night's: a deep plum of the accent's hue, 8.2:1 on it. -->
    <color name="on_accent_dark">#410B2B</color>

    <!-- Neutral surfaces, in the palette's tones. -->
    <color name="divider">#D9BFCB</color>
    <color name="divider_light">#ECD9E1</color>
    <color name="surface">#F9F1F3</color>

    <!-- A starred message's star: the one fixed hue, since a yellow
         star is what marks importance whatever the theme's accent. -->
    <color name="star">#F2BE3C</color>
    <color name="widget_ground">#FFFFFF</color>
    <color name="widget_text">#301F2A</color>
    <color name="widget_text_secondary">#6F5464</color>

    <!-- The avatars (cairn/changes/redesign-for-the-palette): eight hues,
         a seed's slot of 45 degrees, at one OKLCH lightness, so no hue
         reads heavier than another. A soft fill (0.91 0.045) under the
         letter in a deep tone of its hue (0.42 0.09), 6.3:1 or more; the
         night's in values-night/. -->
    <color name="avatar_fill_0">#FED6D2</color>
    <color name="avatar_fill_1">#F5DDC2</color>
    <color name="avatar_fill_2">#DDE6C5</color>
    <color name="avatar_fill_3">#C9EBD7</color>
    <color name="avatar_fill_4">#BFEBED</color>
    <color name="avatar_fill_5">#D1E2FF</color>
    <color name="avatar_fill_6">#E5DBFC</color>
    <color name="avatar_fill_7">#F8D6E8</color>
    <color name="avatar_ink_0">#773733</color>
    <color name="avatar_ink_1">#6C4302</color>
    <color name="avatar_ink_2">#475411</color>
    <color name="avatar_ink_3">#0C5C3C</color>
    <color name="avatar_ink_4">#04585C</color>
    <color name="avatar_ink_5">#2F4C7E</color>
    <color name="avatar_ink_6">#554077</color>
    <color name="avatar_ink_7">#6F3758</color>

    <array name="avatar_fills">
        <item>@color/avatar_fill_0</item>
        <item>@color/avatar_fill_1</item>
        <item>@color/avatar_fill_2</item>
        <item>@color/avatar_fill_3</item>
        <item>@color/avatar_fill_4</item>
        <item>@color/avatar_fill_5</item>
        <item>@color/avatar_fill_6</item>
        <item>@color/avatar_fill_7</item>
    </array>
    <array name="avatar_inks">
        <item>@color/avatar_ink_0</item>
        <item>@color/avatar_ink_1</item>
        <item>@color/avatar_ink_2</item>
        <item>@color/avatar_ink_3</item>
        <item>@color/avatar_ink_4</item>
        <item>@color/avatar_ink_5</item>
        <item>@color/avatar_ink_6</item>
        <item>@color/avatar_ink_7</item>
    </array>

</resources>
