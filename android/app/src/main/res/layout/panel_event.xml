<?xml version="1.0" encoding="utf-8"?>
<!-- The event editor, the agenda's twin of panel_compose and just as
     much a frame: opened by the calendar FAB, left by the bar's back
     arrow, empty until there is something to put in it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0.25"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_domain_calendar"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/event_new_placeholder"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>
