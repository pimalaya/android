<?xml version="1.0" encoding="utf-8"?>
<!-- The capture widget (CaptureWidget): a home-screen widget takes no
     typed text, so the bar opens the capture sheet over the home screen;
     the count on its right opens the Tasks inbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_capture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_capture_ground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_logo" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="@string/capture_title"
        android:textColor="@color/widget_text_secondary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/widget_inbox"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/widget_capture_count"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
