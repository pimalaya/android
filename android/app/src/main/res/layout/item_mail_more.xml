<?xml version="1.0" encoding="utf-8"?>
<!-- The merged list's last row while older mail is not stored yet: a
     spinner while the next chunk loads, a line saying the network is
     needed when there is none, or that it could not be loaded, which a
     tap tries again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <ProgressBar
        android:id="@+id/mail_more_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/mail_more_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
