<?xml version="1.0" encoding="utf-8"?>
<!-- Contact row, one of its letter's card, on the mail row's shape
     (item_message.xml): the disc, then three lines under a hairline
     parting it from the row above.

     The name leads, ended by the linked-cards count and, for a conflict
     or a divergence, the warning; then the phone, else the email; then
     the addressbook and account. A selection turns the disc into a
     check. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/card_gutter"
    android:paddingEnd="@dimen/card_gutter">

    <LinearLayout
        android:id="@+id/row_card"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <FrameLayout
            android:layout_width="@dimen/card_avatar"
            android:layout_height="@dimen/card_avatar"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/contact_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/contact_check"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/unread_dot"
                android:contentDescription="@string/selected"
                android:padding="9dp"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/contact_divider"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/divider_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/contact_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="22dp"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/contact_link_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_link_add"
                        android:tint="?android:attr/textColorSecondary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/contact_links"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/contact_diverged"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/contact_diverged"
                        android:src="@drawable/ic_diverged"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/contact_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:lineHeight="20dp"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/contact_origin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineHeight="20dp"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
