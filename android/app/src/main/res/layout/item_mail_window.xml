<?xml version="1.0" encoding="utf-8"?>
<!-- The merged list's footer while a shown account has more to load: a
     button taking the next step of each, and what a step brings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <Button
        android:id="@+id/mail_window_load"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/button_tonal"
        android:stateListAnimator="@null"
        android:text="@string/mail_more_load"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mail_window_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />
</LinearLayout>
