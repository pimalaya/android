<?xml version="1.0" encoding="utf-8"?>
<!-- The main column (one persistent app bar over the content flipper:
     navigating flips only the inner content) plus the whole-frame
     overlays, bar included. The auth sheet and the shared FAB live in
     the drawer's content; the account settings overlay sits after the
     DrawerLayout so it draws above the open drawer: an account row
     raises it without closing the drawer, and closing it lands back on
     that same open drawer (it carries its own save FAB for the same
     reason). applyChrome (MainActivity) reconfigures the chrome per
     screen. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content: the persistent app bar over the content flipper,
         the auth sheet overlay and the FAB, all under the drawer. It does
         not clip, so the FAB's elevation shadow (which spills past the
         snug fab_frame) renders in full. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/app_bar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/app_bar_padding"
        android:paddingEnd="@dimen/app_bar_padding">

        <!-- Editor, addressbooks, advanced and auth screens. -->
        <ImageButton
            android:id="@+id/bar_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/button_tonal"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- The accounts drawer, behind the burger that says so. The
             app's mark stood here for a while; a logo is identity and
             not an action, and the drawer it opened had to be guessed. -->
        <ImageButton
            android:id="@+id/bar_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/button_tonal"
            android:contentDescription="@string/accounts_open"
            android:src="@drawable/ic_menu"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- A selection, of contacts or mail: cancel it. -->
        <ImageButton
            android:id="@+id/selection_close"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/cancel_selection"
            android:src="@drawable/ic_close"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- The screen's title: the domain's name on the lists, the
             contact's name on the editor, the selected count during a
             selection. It ellipsizes rather than pushing the trailing
             buttons off a narrow bar. -->
        <TextView
            android:id="@+id/bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/app_bar_title_padding"
            android:paddingEnd="@dimen/app_bar_title_padding"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Contacts: the next-birthday dialog. -->
        <ImageButton
            android:id="@+id/contacts_birthdays"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/birthdays_title"
            android:src="@drawable/ic_birthday"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Contacts: the duplicate remover. -->
        <ImageButton
            android:id="@+id/contacts_duplicates"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/dup_find"
            android:src="@drawable/ic_find_duplicates"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Contacts: import and export, one menu of the two. -->
        <ImageButton
            android:id="@+id/contacts_transfer"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/contacts_transfer"
            android:src="@drawable/ic_import_export"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Every list screen's two-axis filter, last so it sits at the
             same spot whatever the domain. Tinted with the accent while
             it hides anything, so a narrowed list never looks like an
             empty one. -->
        <ImageButton
            android:id="@+id/bar_filter"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/filter_title"
            android:src="@drawable/ic_filter_list"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Contacts selection mode: merge the selected cards. -->
        <ImageButton
            android:id="@+id/contacts_merge"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/merge_selected"
            android:src="@drawable/ic_merge"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/contacts_delete"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/delete_selected"
            android:src="@drawable/ic_delete_bar"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Mail selection mode: read or unread, star or unstar, and
             delete, over every selected message. -->
        <ImageButton
            android:id="@+id/mail_select_seen"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/message_mark_read"
            android:src="@drawable/ic_check"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/mail_select_flag"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/message_flag"
            android:src="@drawable/ic_star"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/mail_select_delete"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/message_delete"
            android:src="@drawable/ic_delete_bar"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- A selection, of contacts or mail: select or clear every row. The
             box is centred in an app-bar-button-wide slot, exactly like
             the per-row checkboxes (contact_end_slot). -->
        <FrameLayout
            android:id="@+id/selection_all_slot"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/selection_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:buttonTint="?android:attr/textColorPrimary"
                android:contentDescription="@string/select_all" />

        </FrameLayout>

        <!-- Editor: the addressbooks the contact belongs to, the one
             placement gesture (docs/merged-view.md). -->
        <ImageButton
            android:id="@+id/contact_books"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/manage_books_title"
            android:src="@drawable/ic_account"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Editor: the advanced raw-property editor. -->
        <ImageButton
            android:id="@+id/contact_advanced"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/advanced_open"
            android:src="@drawable/ic_advanced"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Editor: reveal more fields; the FAB is the validate (check)
             action. Hidden in conflict mode where nothing can be added. -->
        <ImageButton
            android:id="@+id/contact_add_field"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/contact_add_field"
            android:src="@drawable/ic_add_entry"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <!-- Reader: what is done to the open message as a whole, one
             tonal pill of the two. The star stays beside the subject. -->
        <LinearLayout
            android:id="@+id/message_actions"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_tonal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/message_view_unread"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/message_mark_unread"
                android:src="@drawable/ic_visibility_off"
                android:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/message_view_delete"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/message_delete"
                android:src="@drawable/ic_delete_bar"
                android:tint="?android:attr/textColorPrimary" />

        </LinearLayout>

        <!-- Composer: send, an accent pill naming what it does. -->
        <TextView
            android:id="@+id/bar_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_pill"
            android:drawableStart="@drawable/ic_send"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:text="@string/compose_send"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Editor: remove what is open. In the bar rather than on the
             page, because it acts on the whole of what the page shows
             and not on any one row of it. -->
        <ImageButton
            android:id="@+id/bar_delete"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/event_delete"
            android:src="@drawable/ic_delete_bar"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/panel_contacts" />

        <include layout="@layout/panel_contact" />

        <include layout="@layout/panel_advanced" />

        <include layout="@layout/panel_source" />

        <include layout="@layout/panel_mail" />

        <include layout="@layout/panel_calendar" />

        <include layout="@layout/panel_compose" />

        <include layout="@layout/panel_message" />

        <include layout="@layout/panel_event_view" />

    </ViewFlipper>

    <!-- The app's top-level navigation, on the three lists only: one
         item per domain, mail, contacts then calendars, the one on
         screen on an accent pill (showDomainBar). It takes the bottom
         system inset, so the lists above it need none. -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_mail"
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <ImageView
                    android:layout_width="@dimen/item_icon"
                    android:layout_height="@dimen/item_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_domain_mail" />

                <!-- The unread count, over the icon's top end. -->
                <TextView
                    android:id="@+id/nav_mail_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/count_badge"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/domain_mail"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_contacts"
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <ImageView
                    android:layout_width="@dimen/item_icon"
                    android:layout_height="@dimen/item_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_domain_contacts" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/domain_contacts"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_calendar"
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <ImageView
                    android:layout_width="@dimen/item_icon"
                    android:layout_height="@dimen/item_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_domain_calendar" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/domain_calendar"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <!-- The auth sheet: a whole-frame overlay with its own bar, fading
         in over the content (the drawer is closed while it runs). -->
    <include layout="@layout/panel_auth" />

    <!-- The screens' primary action, fixed above everything: add on
         the lists, save on the editor, continue through the auth flow
         (icon and action per screen in applyChrome). While an auth step
         works the loader sits on the disc, its icon hidden. -->
    <FrameLayout
        android:id="@+id/fab_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/fab"
            android:layout_width="@dimen/fab"
            android:layout_height="@dimen/fab"
            android:background="@drawable/fab_background"
            android:contentDescription="@string/contacts_add"
            android:elevation="@dimen/fab_elevation"
            android:src="@drawable/ic_add" />

        <ProgressBar
            android:id="@+id/fab_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:elevation="@dimen/fab_elevation"
            android:indeterminateTint="?android:attr/colorAccent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- The lists' add button: the FAB's disc stretched over a label,
         which folds away while the list scrolls down (ListHeader). It
         sits above the bottom navigation the lists carry; the plain FAB
         above serves every other screen. -->
    <LinearLayout
        android:id="@+id/fab_extended"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fab"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_above_nav"
        android:background="@drawable/fab_extended"
        android:clickable="true"
        android:elevation="@dimen/fab_elevation"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minWidth="@dimen/fab"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fab_extended_icon"
            android:layout_width="@dimen/item_icon"
            android:layout_height="@dimen/item_icon"
            android:contentDescription="@null"
            android:src="@drawable/ic_add" />

        <TextView
            android:id="@+id/fab_extended_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    </FrameLayout>

    <!-- The drawer: the app's name, one card per account (reloadHome
         fills home_container; each card opens the account's settings),
         scrolling over a line and the actions fixed at the bottom. Width caps at 320dp per the drawer
         spec. -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:attr/colorBackground"
        android:elevation="16dp"
        android:orientation="vertical">

        <!-- Title bar: the app's name, then a tonal cross closing the
             drawer, as tall as the app bar so their bottoms line up. -->
        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/app_bar_height"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/drawer_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_tonal"
                android:contentDescription="@string/drawer_close"
                android:src="@drawable/ic_close"
                android:tint="?android:attr/textColorPrimary" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/home_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- The drawer's empty state, shown when no real account
                     is configured: an icon and a title. Adding an account
                     is the first action below. -->
                <LinearLayout
                    android:id="@+id/drawer_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:alpha="0.25"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_no_account"
                        android:tint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.25"
                        android:gravity="center"
                        android:text="@string/no_account"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_light" />

        <!-- The actions, fixed under the scrolling cards: add an
             account, sync, then About (its dialog carries the app
             version). -->
        <LinearLayout
            android:id="@+id/drawer_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/drawer_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/drawer_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/drawer_tile">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_account_add"
                        android:tint="?android:attr/textColorPrimary" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/add_account"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="?android:attr/textColorSecondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawer_sync"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/drawer_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/drawer_tile">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sync"
                        android:tint="?android:attr/textColorPrimary" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sync_accounts"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="?android:attr/textColorSecondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawer_about"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/drawer_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/drawer_tile">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        android:tint="?android:attr/textColorPrimary" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/about"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="?android:attr/textColorSecondary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

    <!-- One account's settings: same overlay treatment, but above the
         DrawerLayout, so the drawer's account rows raise it over the
         open drawer and closing it reveals that drawer again. -->
    <include layout="@layout/panel_account" />

</FrameLayout>
