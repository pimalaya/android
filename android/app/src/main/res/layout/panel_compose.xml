<?xml version="1.0" encoding="utf-8"?>
<!-- The message composer: one card of labelled rows for who it is
     from, who it goes to and what it is about, then the text under it.
     Sending is the bar's (bar_send).

     Each address field holds one chip per recipient (ChipField),
     since a comma is not something anybody should have to know to
     write to two people. The copy rows open only when they are asked
     for, so the ordinary message is three rows and a body.

     A rich message is Markdown (MarkdownField); its formatting bar sits
     under the page, above the keyboard, while the text has the focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compose_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:divider="@drawable/divider_thin"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ComposeLabel"
                        android:text="@string/compose_from_label" />

                    <TextView
                        android:id="@+id/compose_from"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ComposeLabel"
                        android:id="@+id/compose_to_label"
                        android:text="@string/compose_to" />

                    <org.pimalaya.ui.ChipField
                        android:id="@+id/compose_to"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <!-- Opens the two copy rows, then goes. -->
                    <TextView
                        android:id="@+id/compose_copies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_circle"
                        android:contentDescription="@string/compose_add_copies"
                        android:padding="8dp"
                        android:text="@string/compose_copies_short"
                        android:textColor="?android:attr/colorAccent"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/compose_cc_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/ComposeLabel"
                        android:id="@+id/compose_cc_label"
                        android:text="@string/compose_cc" />

                    <org.pimalaya.ui.ChipField
                        android:id="@+id/compose_cc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/compose_bcc_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/ComposeLabel"
                        android:id="@+id/compose_bcc_label"
                        android:text="@string/compose_bcc" />

                    <org.pimalaya.ui.ChipField
                        android:id="@+id/compose_bcc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ComposeLabel"
                        android:id="@+id/compose_subject_label"
                        android:labelFor="@+id/compose_subject"
                        android:text="@string/compose_subject" />

                    <EditText
                        android:id="@+id/compose_subject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:singleLine="true"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <org.pimalaya.mail.MarkdownField
                android:id="@+id/compose_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/compose_body"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="4dp"
                android:minLines="8"
                android:padding="8dp"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

    <HorizontalScrollView
        android:id="@+id/compose_format_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/colorBackground"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/compose_bold"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_bold"
                android:src="@drawable/ic_format_bold" />

            <ImageButton
                android:id="@+id/compose_italic"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_italic"
                android:src="@drawable/ic_format_italic" />

            <ImageButton
                android:id="@+id/compose_strike"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_strike"
                android:src="@drawable/ic_format_strikethrough" />

            <ImageButton
                android:id="@+id/compose_code"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_code"
                android:src="@drawable/ic_code" />

            <ImageButton
                android:id="@+id/compose_link"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_link"
                android:src="@drawable/ic_link" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/divider_thin" />

            <ImageButton
                android:id="@+id/compose_bullets"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_bullets"
                android:src="@drawable/ic_format_list_bulleted" />

            <ImageButton
                android:id="@+id/compose_numbers"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_numbers"
                android:src="@drawable/ic_format_list_numbered" />

            <ImageButton
                android:id="@+id/compose_quote"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_quote"
                android:src="@drawable/ic_format_quote" />

            <ImageButton
                android:id="@+id/compose_clear"
                style="@style/ComposeFormatButton"
                android:contentDescription="@string/compose_format_clear"
                android:src="@drawable/ic_format_clear" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
