<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of the app bar title's domain dropdown: the domain's glyph
     over the same 24dp grid the bar's own buttons use, then its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/item_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/item_padding"
    android:paddingEnd="@dimen/item_padding">

    <ImageView
        android:id="@+id/domain_icon"
        android:layout_width="@dimen/item_icon"
        android:layout_height="@dimen/item_icon"
        android:layout_marginEnd="@dimen/item_gap"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/domain_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/item_text" />

</LinearLayout>
