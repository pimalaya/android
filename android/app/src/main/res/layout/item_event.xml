<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda row, on the same frame as item_contact and item_message: an
     initial disc where the contact's initial is, a body of a title over
     a supporting line, and a top-aligned trailing column.

     The disc stands for the calendar rather than the entry, initial and
     colour both, the way the mail row's disc stands for the sender: one
     calendar's rows read as one calendar's. What kind of entry it is
     leads the row instead, in the column the bar title leaves clear,
     since that is one glyph and not a thing to name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/app_bar_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/item_padding"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/event_component"
        android:layout_width="@dimen/item_lead"
        android:layout_height="@dimen/item_lead"
        android:layout_marginEnd="@dimen/app_bar_title_padding"
        android:contentDescription="@string/event_component_event"
        android:padding="12dp"
        android:src="@drawable/ic_component_event"
        android:tint="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/event_avatar"
        android:layout_width="@dimen/item_avatar"
        android:layout_height="@dimen/item_avatar"
        android:layout_marginEnd="@dimen/item_gap"
        android:gravity="center"
        android:textColor="#ffffff"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/event_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="24dp"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <!-- How long it runs and which calendar it is in, the way a mail
             row says its mailbox and account. -->
        <TextView
            android:id="@+id/event_origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="16dp"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Top-aligned, where the mail row puts its date, and answering
         the same question: how far off the occurrence is. The rows are
         one scrolling scale of time, so the distance is what says where
         on it a row sits; the exact moment is one tap away, on the
         entry's own page. -->
    <TextView
        android:id="@+id/event_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:lineHeight="24dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

</LinearLayout>
