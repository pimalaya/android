<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda row, one of the day's card: when it starts, the calendar's
     disc, then the entry over how long it runs and where it is filed.

     The start leads, in a fixed-width column, because the day header
     above already says which day: what is left to scan down a card is
     the hour. The disc stands for the calendar, initial and colour,
     the way a mail row's stands for its sender; the kind of entry ends
     the title's line as a glyph. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/card_gutter"
    android:paddingEnd="@dimen/card_gutter">

    <LinearLayout
        android:id="@+id/row_card"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/event_countdown"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/event_avatar"
            android:layout_width="@dimen/card_avatar"
            android:layout_height="@dimen/card_avatar"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:textColor="#ffffff"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/event_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineHeight="22dp"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/event_component"
                    android:layout_width="@dimen/message_flag"
                    android:layout_height="@dimen/message_flag"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/event_component_event"
                    android:src="@drawable/ic_component_event"
                    android:tint="?android:attr/textColorSecondary" />

            </LinearLayout>

            <TextView
                android:id="@+id/event_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineHeight="20dp"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
