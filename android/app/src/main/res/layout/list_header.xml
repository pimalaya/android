<?xml version="1.0" encoding="utf-8"?>
<!-- A list's large title, scrolling with its rows: the domain over a
     supporting line, then what the domain filters with (a search
     field, chips, a week). ListHeader shows what its list
     uses and hands the bar the title once this one scrolls away. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/large_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/header_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="20dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- While a sync runs: whose account, then the step, over a thin bar,
         determinate once the pass can count. In place of the meta line,
         the search field and the chips, which ListHeader hides meanwhile. -->
    <LinearLayout
        android:id="@+id/header_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/header_sync_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/header_sync_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/header_sync_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="?android:attr/colorAccent"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/sync_bar" />

    </LinearLayout>

    <!-- The search field: a tonal pill with a clear cross once it holds
         something. -->
    <LinearLayout
        android:id="@+id/header_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/button_tonal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/header_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/header_search_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_cancel"
            android:tint="?android:attr/textColorSecondary"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/header_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/header_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- The week: its month and year over one card of seven days. -->
    <LinearLayout
        android:id="@+id/header_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- The month and year, then the week's number between the
             arrows to the weeks either side. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/header_week_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/week_previous"
                android:src="@drawable/ic_chevron_left"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/header_week_number"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_tonal"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/header_week_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/week_next"
                android:src="@drawable/ic_chevron_right"
                android:tint="?android:attr/textColorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/card_gutter"
            android:background="@drawable/card_group"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp" />

    </LinearLayout>

</LinearLayout>
