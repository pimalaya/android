<?xml version="1.0" encoding="utf-8"?>
<!-- The capture sheet, on the sync sheet's ground (sync_sheet.xml): what
     is on the person's mind, an optional note, where it goes, and the
     mail it was captured from when there is one (CaptureSheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sync_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/sync_sheet_handle" />

    <TextView
        android:id="@+id/capture_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/capture_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/capture_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/capture_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4"
        android:textSize="17sp" />

    <EditText
        android:id="@+id/capture_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/capture_note"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="6"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/capture_add_note"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="@string/capture_add_note"
        android:textColor="?android:attr/colorAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/capture_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/button_tonal"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/capture_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/capture_offline"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/capture_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/capture_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_save"
            android:textColor="?android:attr/colorAccent"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
