<?xml version="1.0" encoding="utf-8"?>
<!-- The message reader: the subject, where the message is filed under
     it, a sender card, then the message itself filling what is left.
     What is done to the message sits in the bar (message_actions).

     Everything above the body comes from the list row, which already
     knew the subject, the sender and the date, so it is drawn at once
     and the body slots in under it when the fetch returns. The two are
     stacked rather than scrolled together because the body is a web
     view when the message is HTML, and a web view inside a scroll view
     scrolls twice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/message_view_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Where the message is filed: the mailbox and the account, the
             one thing a merged list cannot leave implicit. -->
        <TextView
            android:id="@+id/message_view_mailbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <!-- The meta card, folded by default to the sender and the date: a
             tap unfolds the recipients, the full date and the links. Its
             text alone scrolls sideways when an address runs past it. -->
        <LinearLayout
            android:id="@+id/message_view_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <!-- The same disc the row carried, keyed by the same address,
                 so opening a message keeps the mark the eye was
                 following. -->
            <TextView
                android:id="@+id/message_view_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/message_view_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/message_view_from"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/message_view_recipients"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="false"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />

                        <!-- How long ago folded; unfolded, the exact date
                             beside it: the exact one answers "when", the
                             relative one "how long have I been sitting on
                             this". -->
                        <TextView
                            android:id="@+id/message_view_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- What the message is linked to, opened in a dialog: the
                     body fills the rest of the page, so the Linked card
                     cannot sit under it. -->
                <TextView
                    android:id="@+id/message_view_linked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/badge_background"
                    android:drawableStart="@drawable/ic_link"
                    android:drawablePadding="6dp"
                    android:drawableTint="?android:attr/textColorSecondary"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <ImageView
                android:id="@+id/message_view_fold"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top"
                android:layout_marginStart="4dp"
                android:padding="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                android:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- One badge per attachment, wrapping onto as many lines as it
             takes: what a message carries is part of what it is, and a
             count would send the reader looking for a list. -->
        <LinearLayout
            android:id="@+id/message_view_attachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/message_view_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- A spinner while the body is on its way: the wait is short and
         has nothing to report, and a sentence in its place reads as
         content that failed to be content. -->
    <ProgressBar
        android:id="@+id/message_view_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="?android:attr/colorAccent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message_view_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alpha="0.5"
        android:gravity="center"
        android:padding="48dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

</LinearLayout>
