<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar agenda content; its bar elements and FAB live in the
     persistent chrome (activity_main.xml). Same shape as
     panel_contacts: a pull-to-refresh list over a centred empty state,
     so the merged view reads identically across the three domains. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/calendar_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/calendar_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:listSelector="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingBottom="88dp"
            android:scrollbars="none" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Centred in what the list's header leaves below it, which
         ListHeader keeps as this view's top padding. -->
    <LinearLayout
        android:id="@+id/calendar_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_domain_calendar"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/calendar_empty"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>
