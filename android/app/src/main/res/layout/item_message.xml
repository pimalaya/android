<?xml version="1.0" encoding="utf-8"?>
<!-- Mail row, one of the day's card (CardSections sets row_card's
     background by its place in the card): the sender's disc, then three
     lines under a hairline parting it from the row above.

     The sender leads, behind the replied mark and ended by the time and
     the unread dot; the subject follows, ended by its marks, read from
     the edge inwards: the paperclip of a message carrying an attachment,
     the star of an important one, the dot above sharing the paperclip's
     column; then the mailbox and account a merged list has to say. A long press selects the row, the disc turning into a
     check. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:paddingStart="@dimen/card_gutter"
    android:paddingEnd="@dimen/card_gutter">

    <LinearLayout
        android:id="@+id/row_card"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <FrameLayout
            android:layout_width="@dimen/card_avatar"
            android:layout_height="@dimen/card_avatar"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/message_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/message_check"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/selected"
                android:padding="9dp"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/message_divider"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/divider_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/message_answered"
                        android:layout_width="@dimen/message_flag"
                        android:layout_height="@dimen/message_flag"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/message_answered"
                        android:src="@drawable/ic_reply"
                        android:tint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/message_from"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="22dp"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/message_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <!-- Centred over the paperclip's 16dp column below. -->
                    <View
                        android:id="@+id/message_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/unread_dot" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/message_subject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/message_star"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/message_flagged"
                        android:src="@drawable/ic_star_filled"
                        android:tint="@color/star" />

                    <ImageView
                        android:id="@+id/message_attachment"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/message_attachment_chip"
                        android:src="@drawable/ic_attach_file"
                        android:tint="?android:attr/textColorSecondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/message_origin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="20dp"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
