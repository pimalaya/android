<?xml version="1.0" encoding="utf-8"?>
<!-- The contacts list content; its bar elements and FAB live in the
     persistent chrome (activity_main.xml). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Pull down anywhere on the list to sync every account. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/contacts_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/contacts_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="88dp"
            android:scrollbars="none" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/contacts_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0.25"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_no_contact"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_title"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title"
            android:textColor="?android:attr/textColorSecondary"
	    android:textSize="18sp" />

    </LinearLayout>

    <!-- The section letter of the row at the top of the list, in the
         leading column every row keeps clear: the rows start under the
         bar title, and this is what that space is for on the contacts
         side (the agenda puts a countdown there, the mail list a
         paperclip).

         The slot is one row tall (set to the real height at render time)
         and centres a bar-button-sized round button in it, on the bar
         logo's own axis, so the letter is the same circle with the same
         ripple as every other button in the app; tapping it selects its
         whole section. -->
    <FrameLayout
        android:id="@+id/contacts_sticky_slot"
        android:layout_width="@dimen/app_bar_button"
        android:layout_height="66dp"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/app_bar_padding">

        <TextView
            android:id="@+id/contacts_sticky_letter"
            android:layout_width="@dimen/app_bar_button"
            android:layout_height="@dimen/app_bar_button"
            android:layout_gravity="center"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="?android:attr/colorAccent"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
